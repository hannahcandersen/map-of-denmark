<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import bfst22.model.*?>

<Scene fx:id="scene" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bfst22.controller.Controller">
    <root>
        <AnchorPane prefHeight="480.0" prefWidth="640.0">
                <MapCanvas fx:id="canvas" height="${scene.height}" onMouseDragged="#onMouseDragged" onMousePressed="#onMousePressed" onScroll="#onScroll" width="${scene.width}" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="38.0">

                </MapCanvas>
         <Pane maxWidth="1.7976931348623157E308" prefHeight="38.0" style="-fx-background-color: EFC0E8;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
               <MenuBar layoutX="7.0" layoutY="7.0">
                 <menus>
                   <Menu mnemonicParsing="false" text="File">
                     <items>
                         <MenuItem mnemonicParsing="false" onAction="#openFile" text="Open file.." />
                         <MenuItem mnemonicParsing="false" onAction="#etEllerAndet" text="Et eller andet" />
                     </items>
                   </Menu>
                 </menus>
               </MenuBar>
                        <TextField fx:id="fromTextField" layoutX="126.0" layoutY="7.0" onKeyReleased="#getSearchResultFrom" prefHeight="25.0" prefWidth="184.0" promptText="Search address" />
      
                        <TextField fx:id="toTextField" layoutX="347.0" layoutY="7.0" onKeyReleased="#getSearchResultTo" prefHeight="25.0" prefWidth="184.0" promptText="Search address" />
                        <Text layoutX="86.0" layoutY="24.0" strokeType="OUTSIDE" strokeWidth="0.0" text="From:" />
                        <Text layoutX="321.0" layoutY="24.0" strokeType="OUTSIDE" strokeWidth="0.0" text="To:" />
                                <Button layoutX="552.0" layoutY="7.0" mnemonicParsing="false" onAction="#searchRoute" prefHeight="26.0" prefWidth="82.0" text="Find route" />
            </children>
         </Pane>
            <ListView fx:id="listViewFrom" layoutX="124.0" layoutY="42.0" onMouseClicked="#chooseAddressFrom" prefHeight="184.0" prefWidth="184.0" visible="false" />
            <ListView fx:id="listViewTo" layoutX="348.0" layoutY="42.0" onMouseClicked="#chooseAddressTo" prefHeight="184.0" prefWidth="184.0" visible="false" />
            <CheckBox fx:id="colorCheckBox" layoutX="545.4" layoutY="54.0" mnemonicParsing="false" onAction="#partyColorToggle" text="Party mode" AnchorPane.rightAnchor="10.600000000000023" />
         <Pane fx:id="warningPane" centerShape="true" layoutX="246.0" layoutY="206.0" maxHeight="74.0" maxWidth="146.0" minHeight="74.0" minWidth="146.0" prefHeight="74.0" prefWidth="146.0" scaleShape="false" style="-fx-background-color: EE4B2B;" visible="false">
            <children>
               <Label fx:id="Warning" layoutX="9.0" layoutY="3.0" text="Epilepsy Warning">
                  <font>
                     <Font name="Comic Sans MS" size="16.0" />
                  </font>
               </Label>
               <Label layoutX="11.0" layoutY="26.0" text="Party mode selected">
                  <font>
                     <Font name="Comic Sans MS" size="13.0" />
                  </font>
               </Label>
               <Button fx:id="warningOkButton" layoutX="57.0" layoutY="46.0" mnemonicParsing="false" onAction="#onClickWarningOk" prefHeight="25.0" prefWidth="31.0" text="Ok" />
            </children>
         </Pane>
         <CheckBox fx:id="pinkCheckBox" layoutX="546.0" layoutY="84.0" mnemonicParsing="false" onAction="#pinkColorToggle" text="Pink mode" AnchorPane.rightAnchor="14.799999999999997" />
         <CheckBox fx:id="debugBox" layoutX="546.0" layoutY="116.0" mnemonicParsing="false" onAction="#onClickdebugBox" text="Debug mode" AnchorPane.rightAnchor="2.0" />
        </AnchorPane>
    </root>
</Scene>
