<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<?import bfst22.model.*?>
<Scene fx:id="scene" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bfst22.controller.Controller">
    <root>
        <AnchorPane prefHeight="480.0" prefWidth="640.0">
                <MapCanvas fx:id="canvas" height="${scene.height}" onMouseDragged="#onMouseDragged" onMousePressed="#onMousePressed" onScroll="#onScroll" width="${scene.width}" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="38.0">

                </MapCanvas>
            <Pane fx:id="transportTypePane" layoutX="124.0" layoutY="45.0" prefHeight="35.0" prefWidth="407.0" style="-fx-background-color: EFC0E8;" AnchorPane.leftAnchor="124.0" visible="false">
                <children>
                    <Button fx:id="transportCloseButton" layoutX="381.0" layoutY="5.0" mnemonicParsing="false" onMouseClicked="#onClickedTransportCloseButton" prefHeight="12.0" prefWidth="6.0" text="X" />
               <RadioButton fx:id="checkBoxCar" layoutX="14.0" layoutY="9.0" mnemonicParsing="false" onAction="#onClickedcheckBoxCar" text="Car" />
               <RadioButton fx:id="checkBoxBicycle" layoutX="78.0" layoutY="9.0" mnemonicParsing="false" onAction="#onClickedcheckBoxBicycle" text="Bicycle" />
               <RadioButton fx:id="checkBoxWalking" layoutX="160.0" layoutY="9.0" mnemonicParsing="false" onAction="#onClickedcheckBoxFoot" text="Walking" />
                </children>
            </Pane>
         <Pane maxWidth="1.7976931348623157E308" prefHeight="38.0" style="-fx-background-color: EFC0E8;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
               <MenuBar layoutX="7.0" layoutY="7.0">
                 <menus>
                   <Menu mnemonicParsing="false" text="File">
                     <items>
                         <MenuItem mnemonicParsing="false" onAction="#openFile" text="Open file.." />
                     </items>
                   </Menu>
                 </menus>
               </MenuBar>
                        <TextField fx:id="fromTextField" layoutX="126.0" layoutY="7.0" onKeyReleased="#getSearchResultFrom" prefHeight="25.0" prefWidth="184.0" promptText="Search address" />
      
                        <TextField fx:id="toTextField" layoutX="347.0" layoutY="7.0" onKeyReleased="#getSearchResultTo" prefHeight="25.0" prefWidth="184.0" promptText="Search address" />
                        <Text layoutX="86.0" layoutY="24.0" strokeType="OUTSIDE" strokeWidth="0.0" text="From:" />
                        <Text layoutX="321.0" layoutY="24.0" strokeType="OUTSIDE" strokeWidth="0.0" text="To:" />
                                <Button fx:id="findRouteButton" layoutX="552.0" layoutY="7.0" mnemonicParsing="false" onAction="#searchRoute" prefHeight="26.0" prefWidth="82.0" text="Find route" />
            </children>
         </Pane>
            <ListView fx:id="listViewFrom" layoutX="124.0" layoutY="42.0" onMouseClicked="#chooseAddressFrom" prefHeight="184.0" prefWidth="184.0" visible="false" />
            <ListView fx:id="listViewTo" layoutX="348.0" layoutY="42.0" onMouseClicked="#chooseAddressTo" prefHeight="184.0" prefWidth="184.0" visible="false" />
            <CheckBox fx:id="colorCheckBox" layoutX="14.0" layoutY="387.0" mnemonicParsing="false" onAction="#partyColorToggle" text="Party mode" AnchorPane.bottomAnchor="75.4" AnchorPane.leftAnchor="14.0" />
         <Pane fx:id="warningPane" centerShape="true" layoutX="246.0" layoutY="206.0" maxHeight="74.0" maxWidth="146.0" minHeight="74.0" minWidth="146.0" prefHeight="74.0" prefWidth="146.0" scaleShape="false" style="-fx-background-color: EE4B2B;" visible="false">
            <children>
               <Label fx:id="Warning" layoutX="9.0" layoutY="3.0" text="Epilepsy Warning">
                  <font>
                     <Font name="Comic Sans MS" size="16.0" />
                  </font>
               </Label>
               <Label layoutX="11.0" layoutY="26.0" text="Party mode selected">
                  <font>
                     <Font name="Comic Sans MS" size="13.0" />
                  </font>
               </Label>
               <Button fx:id="warningOkButton" layoutX="57.0" layoutY="46.0" mnemonicParsing="false" onAction="#onClickWarningOk" prefHeight="25.0" prefWidth="31.0" text="Ok" />
            </children>
         </Pane>
         <CheckBox fx:id="graphCheckBox" layoutX="15.0" layoutY="417.0" mnemonicParsing="false" onAction="#graphColorToggle" text="Graph mode" AnchorPane.bottomAnchor="45.4" AnchorPane.leftAnchor="14.0" />
         <CheckBox fx:id="debugBox" layoutX="15.0" layoutY="449.0" mnemonicParsing="false" onAction="#onClickdebugBox" text="Debug mode" AnchorPane.bottomAnchor="13.399999999999999" AnchorPane.leftAnchor="14.0" />
         <Label fx:id="scaleInfo" layoutX="532.0" layoutY="427.0" prefHeight="28.0" prefWidth="90.0" style="-fx-background-color: EFC0E8; -fx-text-fill: BLACK;" AnchorPane.bottomAnchor="25.0" AnchorPane.rightAnchor="17.599999999999994" />
         <Label layoutX="488.0" layoutY="427.0" prefHeight="28.0" prefWidth="44.0" style="-fx-background-color: EFC0E8;" text="Meters:" AnchorPane.bottomAnchor="25.0" AnchorPane.rightAnchor="108.0" />
        </AnchorPane>
    </root>
</Scene>
