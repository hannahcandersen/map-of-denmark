<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Text?>


<?import bfst22.model.*?>
<Scene fx:id="scene" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bfst22.controller.Controller">
    <root>
        <BorderPane prefHeight="480.0" prefWidth="640.0">
            <center>
                <MapCanvas fx:id="canvas" height="${scene.height}" onMouseDragged="#onMouseDragged" onMousePressed="#onMousePressed" onScroll="#onScroll" width="${scene.width}">
                </MapCanvas>
            </center>
            <top>
                <Pane prefHeight="44.0" prefWidth="640.0" style="-fx-background-color: #6495ED;" BorderPane.alignment="CENTER">
                    <children>
                        <MenuButton layoutX="14.0" layoutY="10.0" mnemonicParsing="false" text="Menu">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#openFile" text="Open file.." />
                                <MenuItem mnemonicParsing="false" onAction="#etEllerAndet" text="Et eller andet" />
                            </items>
                        </MenuButton>
                        <TextField fx:id="fromTextField" layoutX="140.0" layoutY="10.0" onKeyReleased="#getSearchResult" prefHeight="25.0" prefWidth="100.0" promptText="Search address" />
                                <ListView fx:id="listView" layoutX="139.0" layoutY="39.0" prefHeight="184.0" prefWidth="104.0" />
                                <Button layoutX="406.0" layoutY="5.0" mnemonicParsing="false" onAction="#searchRoute" prefHeight="35.0" prefWidth="68.0" text="Search" />

                        <TextField fx:id="toTextField" layoutX="285.0" layoutY="10.0" prefHeight="25.0" prefWidth="100.0" promptText="Search address" />
                        <Text layoutX="100.0" layoutY="27.0" strokeType="OUTSIDE" strokeWidth="0.0" text="From:" />
                        <Text layoutX="260.0" layoutY="27.0" strokeType="OUTSIDE" strokeWidth="0.0" text="To:" />
                    </children>
                </Pane>
            </top>
        </BorderPane>
    </root>
</Scene>
